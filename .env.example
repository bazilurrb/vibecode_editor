# =============================================================================
# VIBECODE EDITOR — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Prisma + MongoDB Atlas)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# -----------------------------------------------------------------------------
DATABASE_URL="mongodb+srv://your_db_user:your_db_password@cluster0.xxxxx.mongodb.net/vibecode?retryWrites=true&w=majority&appName=Cluster0"

# -----------------------------------------------------------------------------
# AUTH.JS v5 (NextAuth)
# AUTH_URL: The canonical URL of your app (no trailing slash)
#   - Local:      http://localhost:3000
#   - Production: https://your-app.vercel.app
# AUTH_SECRET: A random secret used to sign tokens.
#   Generate one with: npx auth secret  OR  openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_URL="http://localhost:3000"
AUTH_SECRET="your_super_secret_random_string_here"

# -----------------------------------------------------------------------------
# GITHUB OAUTH
# Create at: https://github.com/settings/developers -> OAuth Apps
# Callback URL (local):      http://localhost:3000/api/auth/callback/github
# Callback URL (production): https://your-app.vercel.app/api/auth/callback/github
# -----------------------------------------------------------------------------
AUTH_GITHUB_ID="your_github_oauth_app_client_id"
AUTH_GITHUB_SECRET="your_github_oauth_app_client_secret"

# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# Create at: https://console.cloud.google.com -> APIs & Services -> Credentials
# Callback URL (local):      http://localhost:3000/api/auth/callback/google
# Callback URL (production): https://your-app.vercel.app/api/auth/callback/google
# -----------------------------------------------------------------------------
AUTH_GOOGLE_ID="your_google_oauth_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your_google_oauth_client_secret"

# -----------------------------------------------------------------------------
# AI / LLM API KEYS
# Add whichever provider(s) your AI module uses.
# -----------------------------------------------------------------------------

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-proj-..."

# Anthropic / Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY="AIza..."

# -----------------------------------------------------------------------------
# GITHUB API (for repository import feature)
# Optional: Increases rate limit from 60 to 5000 req/hr.
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
# -----------------------------------------------------------------------------
GITHUB_TOKEN="ghp_..."

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
